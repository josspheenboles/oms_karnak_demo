# انسخه إلى .env وعدّل القيم المحلية: cp .env.example .env
#
# Ollama يعمل على الهوست نفسه ويخدم الموديلين (توليد + embeddings).
# لا تضع خدمة ollama في docker-compose؛ الحاويات تصل إليه عبر
# host.docker.internal، وهذا يحتاج extra_hosts في compose (موجود).
OLLAMA_URL=http://host.docker.internal:11434
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=karnak-6b
LLM_API_KEY=ollama
EMBED_MODEL=qwen3-embedding:0.6b

# Postgres (خدمة postgres في compose)
POSTGRES_USER=oms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oms
DATABASE_URL=postgresql://oms:change-me@postgres:5432/oms

# رفع المستندات (T2)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=52428800
